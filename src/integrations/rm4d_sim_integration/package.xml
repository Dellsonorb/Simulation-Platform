<?xml version="1.0"?>
<package format="2">
  <name>rm4d_sim_integration</name>
  <version>0.1.0</version>
  <description>Thin ROS and frame adapter for the external frozen RM4D AUBO baseline.</description>

  <maintainer email="simulation-platform@example.invalid">Simulation Platform Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
</package>
