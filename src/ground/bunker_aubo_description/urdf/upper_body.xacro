<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find aubo_description)/urdf/aubo_i5_macro.xacro"/>
  <xacro:include filename="$(find dh_ag95_description)/urdf/ag95_macro.xacro"/>
  <xacro:include filename="$(find bunker_aubo_description)/urdf/d435_visual.xacro"/>

  <xacro:macro name="bunker_aubo_upper_body" params="
      parent arm_x arm_y arm_z arm_roll arm_pitch arm_yaw
      camera_x camera_y camera_z camera_roll camera_pitch camera_yaw
      camera_enable_rgbd camera_topic_prefix camera_image_width camera_image_height
      camera_update_rate camera_horizontal_fov">
    <link name="aubo_mount_link">
      <inertial>
        <mass value="5.0"/><origin xyz="0 0 0.04" rpy="0 0 0"/>
        <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.025" iyz="0" izz="0.025"/>
      </inertial>
      <visual><geometry><cylinder radius="0.14" length="0.08"/></geometry></visual>
      <collision><geometry><cylinder radius="0.14" length="0.08"/></geometry></collision>
    </link>
    <joint name="aubo_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="aubo_mount_link"/>
      <origin xyz="${arm_x} ${arm_y} ${arm_z}" rpy="${arm_roll} ${arm_pitch} ${arm_yaw}"/>
    </joint>

    <xacro:aubo_i5 prefix="" parent="aubo_mount_link"
                    hw_interface="hardware_interface/PositionJointInterface">
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </xacro:aubo_i5>
    <xacro:dh_ag95_gripper prefix="" parent="ee_link"
        transmission_hw_interface="hardware_interface/PositionJointInterface">
      <origin xyz="0 0 0" rpy="${pi/2} ${pi} ${pi/2}"/>
    </xacro:dh_ag95_gripper>
    <link name="gripper_tcp_link"/>
    <joint name="gripper_tcp_joint" type="fixed">
      <parent link="ee_link"/><child link="gripper_tcp_link"/>
      <origin xyz="0.20 0 0" rpy="0 0 0"/>
    </joint>
    <xacro:d435_visual parent="ee_link"
        x="${camera_x}" y="${camera_y}" z="${camera_z}"
        roll="${camera_roll}" pitch="${camera_pitch}" yaw="${camera_yaw}"
        enable_rgbd="${camera_enable_rgbd}" topic_prefix="${camera_topic_prefix}"
        image_width="${camera_image_width}" image_height="${camera_image_height}"
        update_rate="${camera_update_rate}" horizontal_fov="${camera_horizontal_fov}"/>
  </xacro:macro>
</robot>
