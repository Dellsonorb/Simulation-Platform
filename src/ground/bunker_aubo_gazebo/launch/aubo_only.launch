<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="true"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <param name="robot_description"
         command="$(find xacro)/xacro --inorder '$(find bunker_aubo_gazebo)/urdf/aubo_only.xacro'"/>
  <rosparam command="load"
            file="$(find bunker_aubo_gazebo)/config/aubo_only_controllers.yaml"/>
  <arg name="unpause" value="$(eval '' if arg('paused') else '-unpause')"/>

  <node name="spawn_aubo_i5" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param robot_description -model aubo_i5 $(arg unpause)
              -J shoulder_pan_joint 0.0 -J shoulder_lift_joint -0.5
              -J elbow_joint 1.0 -J wrist_1_joint 0.0
              -J wrist_2_joint 1.0 -J wrist_3_joint 0.0"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        output="screen" args="joint_state_controller arm_controller"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher" output="screen"/>
</launch>
