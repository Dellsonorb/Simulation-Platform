<launch>
  <arg name="gui" default="true"/>
  <arg name="brick_x" default="0.80"/>
  <arg name="brick_y" default="0.0"/>
  <arg name="brick_length" default="0.240"/>
  <arg name="brick_width" default="0.115"/>
  <arg name="brick_height" default="0.053"/>
  <arg name="brick_orientation_mode" default="flat"/>
  <arg name="brick_z"
       default="$(eval 0.5 * float(arg('brick_height')) if arg('brick_orientation_mode') == 'flat' else 0.5 * float(arg('brick_width')))"/>
  <arg name="brick_yaw" default="0.0"/>
  <arg name="brick_mass" default="2.5"/>
  <arg name="camera_enable_rgbd" default="false"/>
  <arg name="camera_topic_prefix" default="/camera"/>
  <arg name="camera_image_width" default="640"/>
  <arg name="camera_image_height" default="480"/>
  <arg name="camera_update_rate" default="15.0"/>
  <arg name="mobile_manipulation_startup" default="false"/>
  <arg name="ag95_effort_coupled" default="false"/>
  <arg name="lock_ag95_open" default="false"/>

  <include file="$(find bunker_aubo_gazebo)/launch/combined_robot.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="camera_enable_rgbd" value="$(arg camera_enable_rgbd)"/>
    <arg name="camera_topic_prefix" value="$(arg camera_topic_prefix)"/>
    <arg name="camera_image_width" value="$(arg camera_image_width)"/>
    <arg name="camera_image_height" value="$(arg camera_image_height)"/>
    <arg name="camera_update_rate" value="$(arg camera_update_rate)"/>
    <arg name="mobile_manipulation_startup"
         value="$(arg mobile_manipulation_startup)"/>
    <arg name="ag95_effort_coupled" value="$(arg ag95_effort_coupled)"/>
    <arg name="lock_ag95_open" value="$(arg lock_ag95_open)"/>
    <arg name="brick_width" value="$(arg brick_width)"/>
    <arg name="brick_height" value="$(arg brick_height)"/>
    <arg name="brick_orientation_mode" value="$(arg brick_orientation_mode)"/>
  </include>

  <param name="brick_description"
         command="$(find xacro)/xacro --inorder '$(find bunker_aubo_gazebo)/urdf/brick.urdf.xacro'
                  length:=$(arg brick_length) width:=$(arg brick_width)
                  height:=$(arg brick_height) mass:=$(arg brick_mass)
                  orientation_mode:=$(arg brick_orientation_mode)"/>
  <node name="spawn_brick" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-urdf -param brick_description -model brick
              -x $(arg brick_x) -y $(arg brick_y) -z $(arg brick_z) -Y $(arg brick_yaw)"/>
</launch>
