<?xml version="1.0"?>
<robot name="aubo_i5_only" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find aubo_description)/urdf/aubo_i5_macro.xacro"/>

  <link name="world"/>
  <xacro:aubo_i5 prefix="" parent="world"
                  hw_interface="hardware_interface/PositionJointInterface">
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </xacro:aubo_i5>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
      <robotParam>/robot_description</robotParam>
    </plugin>
  </gazebo>
</robot>
