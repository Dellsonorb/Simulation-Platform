Panels:
  - Class: rviz/Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: true
    - Class: rviz/Path
      Name: Global Plan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
    - Class: rviz/Path
      Name: Local Plan
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
    - Class: rviz/Pose
      Name: Generated Approach Pose
      Enabled: true
      Topic: /bunker/approach_pose
    - Class: rviz/MarkerArray
      Name: Brick And Approach
      Enabled: true
      Marker Topic: /bunker/approach_markers
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
