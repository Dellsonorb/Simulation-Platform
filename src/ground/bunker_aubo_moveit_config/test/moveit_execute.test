<launch>
  <include file="$(find ground_manipulator_runtime)/launch/ground_robot_standalone.launch">
    <arg name="gui" value="false"/>
  </include>
  <include file="$(find bunker_aubo_moveit_config)/launch/ground_move_group.launch"/>
  <test test-name="moveit_execute" pkg="bunker_aubo_moveit_config"
        type="test_moveit_execute.py" time-limit="120">
    <remap from="joint_states" to="/ground/joint_states"/>
  </test>
</launch>
