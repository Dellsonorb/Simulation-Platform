<launch>
  <arg name="start_gazebo" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <include if="$(arg start_gazebo)"
    file="$(find ground_manipulator_runtime)/launch/ground_robot_standalone.launch">
    <arg name="gui" value="$(arg gui)"/>
  </include>
  <include
    file="$(find bunker_aubo_moveit_config)/launch/ground_move_group.launch"/>
  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(find bunker_aubo_moveit_config)/config/moveit.rviz" output="screen">
    <remap from="joint_states" to="/ground/joint_states"/>
  </node>
</launch>
