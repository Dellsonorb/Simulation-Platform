<?xml version="1.0"?>
<robot name="bunker_aubo">
  <group name="manipulator">
    <chain base_link="aubo_i5_base_link" tip_link="gripper_tcp_link"/>
  </group>
  <group name="gripper">
    <joint name="left_outer_knuckle_joint"/>
  </group>
  <end_effector name="ag95" parent_link="ee_link" group="gripper"
                parent_group="manipulator"/>
  <group_state name="home" group="manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-0.5"/>
    <joint name="elbow_joint" value="1.0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_outer_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_outer_knuckle_joint" value="0.7"/>
  </group_state>
  <disable_collisions link1="base_link" link2="aubo_mount_link" reason="Adjacent"/>
  <disable_collisions link1="aubo_mount_link" link2="aubo_i5_base_link" reason="Adjacent"/>
  <disable_collisions link1="aubo_i5_base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="ee_link" reason="Adjacent"/>
  <disable_collisions link1="ee_link" link2="ag95_base_link" reason="Adjacent"/>
  <disable_collisions link1="ee_link" link2="d435_mount_link" reason="Adjacent"/>
  <disable_collisions link1="ag95_base_link" link2="ag95_body" reason="Adjacent"/>
  <disable_collisions link1="ag95_body" link2="left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ag95_body" link2="left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="left_outer_knuckle" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="left_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="ag95_body" link2="right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ag95_body" link2="right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="right_outer_knuckle" link2="right_finger" reason="Adjacent"/>
  <disable_collisions link1="right_finger" link2="right_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="left_inner_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="left_finger_pad" link2="left_inner_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="left_finger_pad" link2="left_outer_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="left_inner_knuckle" link2="left_outer_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="right_finger" link2="right_inner_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="right_finger_pad" link2="right_inner_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="right_finger_pad" link2="right_outer_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="right_inner_knuckle" link2="right_outer_knuckle" reason="ReferenceModel"/>
  <disable_collisions link1="left_finger" link2="right_finger" reason="Never"/>
  <disable_collisions link1="left_finger_pad" link2="right_finger_pad" reason="Never"/>
  <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
  <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
  <disable_collisions link1="ag95_base_link" link2="left_finger" reason="Never"/>
