  <disable_collisions link1="right_outer_knuckle" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="right_outer_knuckle" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="d435_mount_link" link2="ee_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="ee_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="ag95_base_link" reason="Mounted"/>
  <disable_collisions link1="camera_link" link2="ag95_body" reason="Mounted"/>
</robot>
