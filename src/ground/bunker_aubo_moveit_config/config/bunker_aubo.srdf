  <disable_collisions link1="ag95_body" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="ag95_body" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="ag95_body" link2="wrist_3_link" reason="Never"/>
