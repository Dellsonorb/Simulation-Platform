<?xml version="1.0"?>
<robot name="bunker_aubo">
  <group name="manipulator">
    <chain base_link="ground/aubo_i5_base_link"
           tip_link="ground/gripper_tcp_link"/>
  </group>
  <group name="gripper">
    <joint name="left_outer_knuckle_joint"/>
  </group>
  <end_effector name="ag95" parent_link="ground/ee_link" group="gripper"
                parent_group="manipulator"/>

  <group_state name="home" group="manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-0.5"/>
    <joint name="elbow_joint" value="1.0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_outer_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_outer_knuckle_joint" value="0.7"/>
  </group_state>

  <disable_collisions link1="ground/base_link" link2="ground/aubo_mount_link" reason="Adjacent"/>
  <disable_collisions link1="ground/aubo_mount_link" link2="ground/aubo_i5_base_link" reason="Adjacent"/>
  <disable_collisions link1="ground/aubo_i5_base_link" link2="ground/shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="ground/shoulder_link" link2="ground/upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="ground/upper_arm_link" link2="ground/forearm_link" reason="Adjacent"/>
  <disable_collisions link1="ground/forearm_link" link2="ground/wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="ground/wrist_1_link" link2="ground/wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="ground/wrist_2_link" link2="ground/wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="ground/wrist_3_link" link2="ground/ee_link" reason="Adjacent"/>
  <disable_collisions link1="ground/ee_link" link2="ground/ag95_base_link" reason="Adjacent"/>
  <disable_collisions link1="ground/ee_link" link2="ground/d435_mount_link" reason="Adjacent"/>
  <disable_collisions link1="ground/d435_mount_link" link2="ground/d435_link" reason="Adjacent"/>
  <disable_collisions link1="ground/d435_link" link2="ground/d435_color_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="ground/d435_link" link2="ground/d435_depth_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="ground/ag95_base_link" link2="ground/ag95_body" reason="Adjacent"/>
  <disable_collisions link1="ground/ag95_body" link2="ground/left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ground/ag95_body" link2="ground/left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ground/ag95_body" link2="ground/right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ground/ag95_body" link2="ground/right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="ground/left_outer_knuckle" link2="ground/left_finger" reason="Adjacent"/>
  <disable_collisions link1="ground/right_outer_knuckle" link2="ground/right_finger" reason="Adjacent"/>
  <disable_collisions link1="ground/left_finger" link2="ground/left_finger_pad" reason="Adjacent"/>
  <disable_collisions link1="ground/right_finger" link2="ground/right_finger_pad" reason="Adjacent"/>

  <disable_collisions link1="ground/left_finger" link2="ground/left_inner_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/left_finger_pad" link2="ground/left_inner_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/left_inner_knuckle" link2="ground/left_outer_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/right_finger" link2="ground/right_inner_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/right_finger_pad" link2="ground/right_inner_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/right_inner_knuckle" link2="ground/right_outer_knuckle" reason="ClosedChain"/>
  <disable_collisions link1="ground/left_finger" link2="ground/right_finger" reason="GripperPair"/>
  <disable_collisions link1="ground/left_finger_pad" link2="ground/right_finger_pad" reason="GripperPair"/>
  <disable_collisions link1="ground/left_inner_knuckle" link2="ground/right_inner_knuckle" reason="GripperPair"/>
  <disable_collisions link1="ground/left_outer_knuckle" link2="ground/right_outer_knuckle" reason="GripperPair"/>

  <disable_collisions link1="ground/ee_link" link2="ground/ag95_body" reason="Mounted"/>
  <disable_collisions link1="ground/d435_link" link2="ground/ee_link" reason="Mounted"/>
  <disable_collisions link1="ground/d435_link" link2="ground/ag95_base_link" reason="Mounted"/>
  <disable_collisions link1="ground/d435_link" link2="ground/ag95_body" reason="Mounted"/>
  <disable_collisions link1="ground/ag95_base_link" link2="ground/wrist_3_link" reason="Mounted"/>
  <disable_collisions link1="ground/ag95_body" link2="ground/wrist_3_link" reason="Mounted"/>

  <disable_collisions link1="ground/base_link" link2="ground/wheel1_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel1_1_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel1_2_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel1_3_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel2_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel2_1_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel2_2_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel2_3_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel3_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel3_1_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel3_2_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel3_3_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel4_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel4_1_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel4_2_Link" reason="Fixed"/>
  <disable_collisions link1="ground/base_link" link2="ground/wheel4_3_Link" reason="Fixed"/>
</robot>
