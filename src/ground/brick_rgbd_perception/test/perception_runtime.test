<launch>
  <include file="$(find brick_rgbd_perception)/launch/perception_demo.launch">
    <arg name="gui" value="false"/>
    <arg name="rviz" value="false"/>
    <arg name="image_view" value="false"/>
  </include>
  <test test-name="perception_runtime" pkg="brick_rgbd_perception"
        type="test_perception_runtime.py" time-limit="120"/>
</launch>
