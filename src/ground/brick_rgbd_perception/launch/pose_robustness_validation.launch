<launch>
  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="strict" default="true"/>
  <arg name="output_dir" default="/tmp/brick_pose_robustness"/>

  <include file="$(find brick_rgbd_perception)/launch/pose_demo.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="image_view" value="false"/>
  </include>

  <node name="brick_pose_robustness_validator"
        pkg="brick_rgbd_perception" type="validate_pose_robustness.py"
        output="screen" required="true">
    <rosparam command="load"
              file="$(find brick_rgbd_perception)/config/brick_pose_robustness.yaml"/>
    <rosparam command="load" ns="observation"
              file="$(find bunker_aubo_gazebo)/config/camera_observation.yaml"/>
    <param name="strict" value="$(arg strict)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
  </node>
</launch>
