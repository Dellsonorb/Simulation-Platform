<?xml version="1.0"?>
<sdf version="1.6">
  <world name="m1_aerial_perception">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <model name="m1_brick">
      <!-- Validation target: keep GT invariant under rotor wash. Gazebo's
           set_model_state service can still reposition a static model between
           lightweight validation scenarios. -->
      <static>true</static>
      <pose>0 0 0.0265 0 0 0</pose>
      <link name="brick_link">
        <inertial>
          <mass>0.45</mass>
          <inertia>
            <ixx>0.000473</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001598</iyy><iyz>0</iyz><izz>0.001875</izz>
          </inertia>
        </inertial>
        <collision name="brick_collision">
          <geometry><box><size>0.20 0.10 0.053</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="brick_visual">
          <geometry><box><size>0.20 0.10 0.053</size></box></geometry>
          <material>
            <ambient>0.85 0.03 0.02 1</ambient>
            <diffuse>0.85 0.03 0.02 1</diffuse>
            <specular>0.05 0.01 0.01 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
  </world>
</sdf>
