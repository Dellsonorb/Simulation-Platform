<?xml version="1.0"?>
<package format="2">
  <name>livox_laser_gazebo_plugins</name>
  <version>0.0.0</version>
  <description>
    Gazebo plugin support for the imported Livox simulation component. The
    base import provenance does not resolve component-specific licensing.
  </description>

  <maintainer email="lfc@todo.todo">lfc</maintainer>
  <license>LicenseRef-Upstream-Unresolved</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>gazebo_dev</build_depend>
  <build_depend>libpcl-all-dev</build_depend>
  <build_depend>pcl_conversions</build_depend>
  <build_depend>prometheus_msgs</build_depend>
  <build_depend>protobuf-dev</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf</build_depend>

  <build_export_depend>gazebo_dev</build_export_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <build_export_depend>pcl_conversions</build_export_depend>
  <build_export_depend>prometheus_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>tf</build_export_depend>

  <exec_depend>gazebo_dev</exec_depend>
  <exec_depend>pcl_conversions</exec_depend>
  <exec_depend>prometheus_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf</exec_depend>

  <export/>
</package>
