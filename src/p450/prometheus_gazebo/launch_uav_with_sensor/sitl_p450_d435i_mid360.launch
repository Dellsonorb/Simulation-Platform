<launch>
  <arg name="gazebo_enable" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find prometheus_gazebo)/gazebo_worlds/planning_worlds/planning_easy.world"/>
  <arg name="rviz_enable" default="true"/>
  <arg name="rviz_config" default="$(find prometheus_gazebo)/launch_basic/prometheus_mid360.rviz"/>
  <arg name="vehicle" default="p450_D435i_mid360"/>
  <arg name="uav1_id" default="1"/>
  <arg name="uav1_init_x" default="0.0"/>
  <arg name="uav1_init_y" default="0.0"/>
  <arg name="uav1_init_yaw" default="0.0"/>

  <group if="$(arg gazebo_enable)">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world)"/>
      <arg name="use_sim_time" value="false"/>
      <arg name="gui" value="$(arg gui)"/>
    </include>
  </group>

  <group if="$(arg rviz_enable)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)"/>
  </group>

  <include file="$(find prometheus_gazebo)/launch_basic/sitl_px4_outdoor.launch">
    <arg name="uav_id" value="$(arg uav1_id)"/>
    <arg name="vehicle" value="$(arg vehicle)"/>
    <arg name="px4_vehicle" value="p450"/>
    <arg name="uav_init_x" value="$(arg uav1_init_x)"/>
    <arg name="uav_init_y" value="$(arg uav1_init_y)"/>
    <arg name="uav_init_z" value="0.15"/>
    <arg name="uav_init_yaw" value="$(arg uav1_init_yaw)"/>
  </include>

  <node pkg="tf" type="static_transform_publisher" name="tf_camera_d435i_$(arg uav1_id)"
        args="0 0 0 0 0 0 /uav$(arg uav1_id)/camera_link /uav$(arg uav1_id)/d435i_link 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_base_camera_$(arg uav1_id)"
        args="0.095 0 0 0 0.35 0 base_link /uav$(arg uav1_id)/camera_link 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_base_camera_imu_$(arg uav1_id)"
        args="0.095 0 0 0 0.35 0 base_link /uav$(arg uav1_id)/camera_imu_link 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_base_lidar_$(arg uav1_id)"
        args="0.13 0 0.23 0 0.35 0 base_link /uav$(arg uav1_id)/lidar_link 100"/>
  <node pkg="tf" type="static_transform_publisher" name="tf_mavros_base_$(arg uav1_id)"
        args="0 0 0 0 0 0 map_base_link base_link 100"/>
</launch>
