<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ground_d435" params="parent">
    <link name="d435_mount_link"/>
    <joint name="d435_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="d435_mount_link"/>
      <origin xyz="0.055 0 0.075" rpy="0 0 0"/>
    </joint>

    <link name="d435_link">
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00004" ixy="0" ixz="0"
                 iyy="0.00012" iyz="0" izz="0.00013"/>
      </inertial>
      <visual>
        <geometry><box size="0.09 0.025 0.025"/></geometry>
        <material name="d435_gray"><color rgba="0.25 0.25 0.25 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.09 0.025 0.025"/></geometry>
      </collision>
    </link>
    <joint name="d435_joint" type="fixed">
      <parent link="d435_mount_link"/>
      <child link="d435_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="d435_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="d435_color_optical_frame">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="d435_color_optical_joint" type="fixed">
      <parent link="d435_link"/>
      <child link="d435_color_optical_frame"/>
      <origin xyz="0.05 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="d435_color_optical_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <link name="d435_depth_optical_frame">
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="d435_depth_optical_joint" type="fixed">
      <parent link="d435_link"/>
      <child link="d435_depth_optical_frame"/>
      <origin xyz="0.05 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
    <gazebo reference="d435_depth_optical_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <gazebo reference="d435_color_optical_frame">
      <sensor name="ground_d435_color" type="camera">
        <!-- Gazebo cameras look along local +X; ROS optical frames use +Z. -->
        <pose>0 0 0 0 ${-pi/2} ${pi/2}</pose>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>false</visualize>
        <camera name="ground_d435_color_camera">
          <horizontal_fov>1.211259</horizontal_fov>
          <image>
            <width>640</width><height>480</height><format>R8G8B8</format>
          </image>
          <clip><near>0.10</near><far>10.0</far></clip>
        </camera>
        <plugin name="ground_d435_color_controller"
                filename="libgazebo_ros_camera.so">
          <robotNamespace>/ground</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <cameraName>d435/color</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>ground/d435_color_optical_frame</frameName>
          <updateRate>0.0</updateRate>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="d435_depth_optical_frame">
      <sensor name="ground_d435_depth" type="depth">
        <pose>0 0 0 0 ${-pi/2} ${pi/2}</pose>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <visualize>false</visualize>
        <camera name="ground_d435_depth_camera">
          <horizontal_fov>1.211259</horizontal_fov>
          <image>
            <width>640</width><height>480</height><format>R8G8B8</format>
          </image>
          <clip><near>0.10</near><far>10.0</far></clip>
        </camera>
        <plugin name="ground_d435_depth_controller"
                filename="libgazebo_ros_openni_kinect.so">
          <robotNamespace>/ground</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <cameraName>d435/depth</cameraName>
          <imageTopicName>image_raw_unused</imageTopicName>
          <cameraInfoTopicName>camera_info_unused</cameraInfoTopicName>
          <depthImageTopicName>image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>points</pointCloudTopicName>
          <frameName>ground/d435_depth_optical_frame</frameName>
          <updateRate>0.0</updateRate>
          <hackBaseline>0.050</hackBaseline>
          <pointCloudCutoff>0.10</pointCloudCutoff>
          <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
