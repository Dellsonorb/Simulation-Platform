<?xml version="1.0"?>
<sdf version="1.6">
  <world name="ground_robot_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="ground_scan_obstacle">
      <static>true</static>
      <pose>3.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 1.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 1.0 1.0</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.8 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
