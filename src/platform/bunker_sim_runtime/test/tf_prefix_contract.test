<?xml version="1.0"?>
<launch>
  <group ns="ground">
    <param name="tf_prefix" type="str" value="ground"/>
    <param name="robot_description"
      textfile="$(find bunker_sim_runtime)/test/tf_prefix_fixture.urdf"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher"
      name="robot_state_publisher" output="screen"/>
  </group>
  <test test-name="tf_prefix_contract" pkg="bunker_sim_runtime"
    type="test_tf_prefix_contract.py" time-limit="15.0"/>
</launch>
