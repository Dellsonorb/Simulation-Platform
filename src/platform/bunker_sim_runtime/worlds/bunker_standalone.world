<?xml version="1.0"?>
<sdf version="1.6">
  <world name="bunker_standalone">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="scan_obstacle">
      <static>true</static>
      <pose>2.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 1.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 1.0 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
