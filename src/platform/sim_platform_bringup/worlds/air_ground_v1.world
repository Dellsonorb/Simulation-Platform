<?xml version="1.0"?>
<sdf version="1.6">
  <world name="air_ground_v1">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Robot starts at x=3.0, so this landmark is about 1.30 m ahead
         of its front-mounted 2D LiDAR. -->
    <model name="ground_scan_obstacle">
      <static>true</static>
      <pose>5.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 1.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 1.0 1.0</size></box>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
